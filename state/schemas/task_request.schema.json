{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaart.local/schemas/task_request.schema.json",
  "title": "UA ART Task Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "title"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 20000,
      "default": ""
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|(^|/)\\.\\.(/|$))"
        }
      },
      "default": []
    },
    "production_required": {
      "type": "boolean",
      "default": false
    },
    "read_only": {
      "type": "boolean",
      "default": false
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 1
    },
    "requested_min_class": {
      "type": ["string", "null"],
      "enum": ["FAST", "STANDARD", "CRITICAL", null]
    },
    "ai_requested": {
      "type": "boolean",
      "default": false
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_path",
        "controller_sha256",
        "test_paths",
        "file_sha256",
        "receipt_path",
        "evidence_paths"
      ],
      "properties": {
        "controller_path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
        },
        "controller_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "test_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
          }
        },
        "file_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "receipt_path": {
          "type": "string",
          "pattern": "^state/receipts/[A-Za-z0-9._-]+\\.json$"
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
          }
        },
        "production_required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 1200
        }
      }
    },
    "critical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_approval_path",
        "owner_approval_sha256",
        "manifest_path",
        "manifest_sha256",
        "gate_a_path",
        "gate_b_authorized"
      ],
      "properties": {
        "owner_approval_path": {
          "type": "string",
          "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
        },
        "owner_approval_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "manifest_path": {
          "type": "string",
          "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "gate_a_path": {
          "type": "string",
          "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
        },
        "gate_b_authorized": {
          "type": "boolean"
        },
        "allow_crm_vehicle_data": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
