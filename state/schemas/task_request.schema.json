{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaart.local/schemas/task_request.schema.json",
  "title": "UA ART Task Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "title"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 20000,
      "default": ""
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|(^|/)\\.\\.(/|$))"
        }
      },
      "default": []
    },
    "production_required": {
      "type": "boolean",
      "default": false
    },
    "read_only": {
      "type": "boolean",
      "default": false
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 1
    },
    "requested_min_class": {
      "type": ["string", "null"],
      "enum": ["FAST", "STANDARD", "CRITICAL", null]
    },
    "ai_requested": {
      "type": "boolean",
      "default": false
    }
  }
}
