+    "number_of_gears": "Кількість передач", "front_suspension": "Передня підвіска",
+    "rear_suspension": "Задня підвіска", "front_brakes": "Передні гальма",
+    "rear_brakes": "Задні гальма", "steering_type": "Кермове керування",
