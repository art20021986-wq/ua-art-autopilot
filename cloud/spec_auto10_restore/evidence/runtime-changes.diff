+    if len(starts) != 1 or len(ends) != 1 or starts[0][2] > ends[0][1]:
+        raise ShellError("SHELL_MALFORMED_MARKERS")
+    return starts[0][1], ends[0][2], starts[0][2], ends[0][1]
