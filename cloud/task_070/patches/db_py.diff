+def _ua_lock3_connect(path, timeout=None):
+    # NOTE: no forced global override. Caller (db.connect) decides the real
+    # busy budget. Diagnostics code must never raise this value.
+    effective_timeout = timeout if timeout is not None else ZAMOK_OZHIDANIE_KOROTKII
+    conn = sqlite3.connect(path, timeout=effective_timeout)
+    conn.execute(f"PRAGMA busy_timeout={int(effective_timeout*1000)}")
+    conn.execute("PRAGMA journal_mode=WAL")
+    return conn
