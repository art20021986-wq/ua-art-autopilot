class Task096Error(RuntimeError):
    pass


def utc_now() -> str:
    return (
        dt.datetime.now(dt.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def assert_allowed_write(path: pathlib.Path) -> pathlib.Path:
    resolved = path.resolve()
    try:
        resolved.relative_to(TASK_ROOT)
    except ValueError as exc:
        raise Task096Error("WRITE_PATH_OUTSIDE_TASK_ROOT") from exc
    return resolved


